---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout
    title="Page not found"
    description="The page you are looking for has flown away."
    narrow={true}
    crumbs={[{ label: '404' }]}
>
    <section
        class="border-base-300 bg-base-100 flex flex-col items-center rounded-md border px-6 py-20 text-center"
    >
        <p class="text-primary text-7xl font-black tracking-tight">404</p>
        <h1 class="mt-4 text-2xl font-bold tracking-tight">Page not found</h1>
        <p class="text-base-content/70 mt-2">The page you are looking for has flown away.</p>
        <a href={withBase('/')} class="btn btn-primary mt-6">Back to home</a>
    </section>
</BaseLayout>
