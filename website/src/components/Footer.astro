---
import { SITE } from '../config';
import { withBase } from '../utils/url';

const year = new Date().getFullYear();
---

<footer
    aria-label="Site Info"
    class="border-base-300 text-base-content/70 mt-10 flex flex-row items-center justify-between gap-1 border-t py-6 text-sm"
>
    <p>
        © <time>{year} </time>
        {SITE.author.name}
    </p>
    <p class="flex gap-3">
        <a href={withBase('/privacy-policy')} class="hover:text-primary">Privacy Policy</a>
        <a href={withBase('/sitemap-index.xml')} class="hover:text-primary">Sitemap</a>
    </p>
</footer>
