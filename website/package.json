{
    "name": "website",
    "version": "1.0.0",
    "type": "module",
    "description": "The website for kyleavrett.com",
    "packageManager": "pnpm@11.3.0",
    "engines": {
        "node": ">=22.13.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "astro": "astro",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "typecheck": "astro check",
        "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,mjs,md,mdx,css,json}\"",
        "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,mjs,md,mdx,css,json}\"",
        "test": "vitest run",
        "dev": "astro dev --open",
        "build": "astro build && pnpm run pagefind",
        "preview": "pnpm run build && astro preview",
        "pagefind": "pagefind --site dist --output-subdir _pagefind",
        "postbuild": "echo \"Pagefind index generated in dist/_pagefind\""
    },
    "dependencies": {
        "@astrojs/markdown-satteri": "^0.3.3",
        "@astrojs/mdx": "^7.0.1",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.3",
        "@iconify/types": "^2.0.0",
        "@iconify/utils": "^3.1.4",
        "@nullpinter/satteri-katex": "^0.1.2",
        "astro": "^7.0.5",
        "astro-expressive-code": "^0.44.0",
        "astro-icon": "^1.1.5",
        "mermaid": "^11.16.0",
        "satteri": "^0.10.5",
        "satteri-external-links": "^0.1.0",
        "sharp": "^0.35.4"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@eslint/js": "^10.0.1",
        "@fontsource/inter": "^5.2.8",
        "@fontsource/jetbrains-mono": "5.3.0",
        "@fontsource/source-sans-3": "5.3.0",
        "@iconify-json/lucide": "^1.2.115",
        "@iconify-json/simple-icons": "^1.2.88",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/vite": "^4.3.2",
        "@typescript-eslint/eslint-plugin": "^8.62.1",
        "@typescript-eslint/parser": "^8.62.1",
        "daisyui": "^5.6.10",
        "eslint": "^10.6.0",
        "eslint-plugin-astro": "^3.0.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "katex": "^0.18.1",
        "pagefind": "^1.5.2",
        "prettier": "^3.9.4",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "satori": "^0.29.0",
        "shiki": "^4.3.0",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "vitest": "^4.0.14",
        "zod": "^4.4.3"
    }
}
