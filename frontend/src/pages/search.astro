---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search Kyle Avrett website.">
    <section class="mx-auto max-w-2xl py-10">
        <div class="mb-8 space-y-3">
            <p
                class="text-sm font-medium tracking-wide text-gray-500 uppercase"
            >
                Site search
            </p>
            <h1 class="text-4xl font-bold tracking-tight">Find anything</h1>
            <p class="text-gray-600">
                Search posts, pages, and notes on Kyle Avrett's site.
            </p>
        </div>

        <label class="sr-only" for="search-input">Search this site</label>
        <div
            class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm focus-within:border-gray-400"
        >
            <input
                id="search-input"
                class="w-full rounded-xl px-4 py-3 text-lg outline-none"
                type="search"
                autocomplete="off"
                placeholder="Search..."
            />
        </div>

        <p
            id="search-status"
            class="mt-4 min-h-6 text-sm text-gray-500"
            aria-live="polite"
        >
        </p>
        <ol id="search-results" class="mt-6 space-y-4"></ol>
    </section>

    <script is:inline type="module">
        const pagefind = (await import('/pagefind/pagefind.js')).createInstance(
            {
                baseUrl: '/',
                noWorker: true,
            },
        );
        await pagefind.init();
        const input = document.querySelector('#search-input');
        const status = document.querySelector('#search-status');
        const results = document.querySelector('#search-results');
        let lastSearch = 0;

        input.addEventListener('input', async () => {
            const query = input.value.trim();
            const searchId = ++lastSearch;
            results.textContent = '';

            if (!query) {
                status.textContent = 'Type to search this site.';
                return;
            }

            status.textContent = `Searching for ${query}...`;
            const search = await pagefind.search(query);
            if (searchId !== lastSearch) return;

            status.textContent =
                search.results.length === 1
                    ? '1 result'
                    : `${search.results.length} results`;

            if (!search.results.length) {
                const empty = document.createElement('li');
                empty.className =
                    'rounded-2xl border border-dashed border-gray-300 p-6 text-gray-500';
                empty.textContent = 'No matches. Try a different search.';
                results.append(empty);
                return;
            }

            for (const result of search.results.slice(0, 10)) {
                const data = await result.data();
                if (searchId !== lastSearch) return;

                const item = document.createElement('li');
                const link = document.createElement('a');
                const excerpt = document.createElement('p');

                item.className =
                    'rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md';
                link.className = 'text-lg font-semibold';
                excerpt.className = 'mt-2 text-sm leading-6 text-gray-600';

                link.href = data.url;
                link.textContent = data.meta.title || data.url;
                excerpt.innerHTML = data.excerpt;

                item.append(link, excerpt);
                results.append(item);
            }
        });

        status.textContent = 'Type to search this site.';
    </script>
</BaseLayout>
