---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
---

<BaseLayout title="Search" description="Search Kyle Avrett website.">
    <section>
        <PageHeader
            eyebrow="search"
            title="Find anything"
            description="Search posts, pages, and notes on Kyle Avrett's site."
        />

        <label class="sr-only" for="search-input">Search this site</label>
        <div
            class="rounded-2xl border border-gray-200 p-1 focus-within:border-gray-400"
        >
            <input
                id="search-input"
                class="w-full px-4 py-3 text-lg outline-none"
                type="search"
                autocomplete="off"
                placeholder="Search..."
            />
        </div>

        <p
            id="search-status"
            class="mt-2 min-h-6 text-sm text-gray-500"
            aria-live="polite"
        >
        </p>
        <ol id="search-results" class="mt-6 space-y-4"></ol>
    </section>

    <script is:inline type="module">
        const pagefind = (await import('/pagefind/pagefind.js')).createInstance(
            {
                baseUrl: '/',
                noWorker: true,
            },
        );
        await pagefind.init();
        const input = document.querySelector('#search-input');
        const status = document.querySelector('#search-status');
        const results = document.querySelector('#search-results');
        let lastSearch = 0;

        input.addEventListener('input', async () => {
            const query = input.value.trim();
            const searchId = ++lastSearch;
            results.textContent = '';

            if (!query) {
                status.textContent = 'Type to search this site.';
                return;
            }

            status.textContent = `Searching for ${query}...`;
            const search = await pagefind.search(query);
            if (searchId !== lastSearch) return;

            status.textContent =
                search.results.length === 1
                    ? '1 result'
                    : `${search.results.length} results`;

            if (!search.results.length) {
                const empty = document.createElement('li');
                empty.className =
                    'rounded-2xl border border-dashed border-gray-300 p-6 text-gray-500';
                empty.textContent = 'No matches. Try a different search.';
                results.append(empty);
                return;
            }

            for (const result of search.results.slice(0, 10)) {
                const data = await result.data();
                if (searchId !== lastSearch) return;

                const item = document.createElement('li');
                const link = document.createElement('a');
                const title = document.createElement('span');
                const excerpt = document.createElement('p');

                link.className =
                    'block rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md';
                title.className = 'text-lg font-semibold';
                excerpt.className =
                    'mt-2 text-sm leading-6 font-normal text-gray-600';

                link.href = data.url;
                title.textContent = data.meta.title || data.url;
                excerpt.innerHTML = data.excerpt;

                link.append(title, excerpt);
                item.append(link);
                results.append(item);
            }
        });

        status.textContent = 'Type to search this site.';
    </script>
</BaseLayout>
