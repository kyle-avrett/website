---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getTagsWithCount, tagPath } from '~/utils/posts';
import { Icon } from 'astro-icon/components';

const tags = await getTagsWithCount();
---

<BaseLayout title="Tags" crumbs={[{ label: 'Tags' }]}>
    <header class="mb-6">
        <h1 class="text-3xl font-bold tracking-tight">Tags</h1>
    </header>
    {
        tags.length === 0 ? (
            <p class="text-base-content/70">No tags yet.</p>
        ) : (
            <ul class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <li>
                        <a href={tagPath(tag.name)} class="badge badge-lg gap-1">
                            <Icon name="lucide:tag" width={12} height={12} />
                            {tag.name}
                            <span class="text-base-content/70">{tag.count}</span>
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</BaseLayout>
