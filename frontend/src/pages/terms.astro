---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
    title="Terms of service"
    description="Terms of service for Kyle Avrett website."
>
    <article class="space-y-6">
        <h1 class="text-3xl font-bold">Terms of service</h1>
        <p><strong>Last updated:</strong> September 7, 2026</p>

        <section class="space-y-3">
            <h2 class="text-2xl font-semibold">Use of this site</h2>
            <p>
                You may read, link to, and share public pages on this site. Do
                not try to disrupt, scrape aggressively, or misuse the site.
            </p>
        </section>

        <section class="space-y-3">
            <h2 class="text-2xl font-semibold">Content</h2>
            <p>
                Posts and pages on this site are for general information. They
                are not professional, legal, financial, or security advice for
                your specific situation.
            </p>
        </section>

        <section class="space-y-3">
            <h2 class="text-2xl font-semibold">Ownership</h2>
            <p>
                Unless a page says otherwise, site text, design, and images
                belong to Kyle Avrett. Third-party names, icons, and trademarks
                belong to their owners.
            </p>
        </section>

        <section class="space-y-3">
            <h2 class="text-2xl font-semibold">External links</h2>
            <p>
                This site links to services Kyle Avrett does not control. Those
                services have their own terms and policies.
            </p>
        </section>

        <section class="space-y-3">
            <h2 class="text-2xl font-semibold">No warranty</h2>
            <p>
                The site is provided as is. Kyle Avrett does not promise that it
                will always be available, accurate, or error-free.
            </p>
        </section>

        <section class="space-y-3">
            <h2 class="text-2xl font-semibold">Contact</h2>
            <p>
                Questions about these terms can be sent to <a
                    href="mailto:kyle@kyleavrett.com">kyle@kyleavrett.com</a
                >.
            </p>
        </section>
    </article>
</BaseLayout>
