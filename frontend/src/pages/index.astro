---
import { getCollection } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import LinkCard from '@components/LinkCard.astro';
import OverviewCard from '@components/OverviewCard.astro';
const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const projects = (await getCollection('projects'))
    .filter((project) => !project.data.draft)
    .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
    title="Home"
    description="Kyle Avrett builds software products, engineering teams, and operating systems for SaaS, cloud, healthcare, and software-enabled companies."
>
    <section class="space-y-14">
        <div class="mb-6 space-y-2">
            <h1 class="text-4xl font-bold tracking-tight">Hi, I’m Kyle</h1>
            <p class="text-gray-600">
                I’m a hands-on technical leader who likes turning messy business
                problems into useful software, steady teams, and measurable
                outcomes
            </p>
        </div>

        <OverviewCard
            link="/work/"
            linkText="See work history"
            secondLink="mailto:kyle@kyleavrett.com"
            secondLinkText="Get in touch"
        >
            <p>
                I’ve spent 12+ years building software and 6+ years leading
                engineering teams across SaaS, cloud infrastructure, healthcare,
                and software-enabled operations.
            </p>
            <p>
                I’ve founded and exited a B2B SaaS company, led teams from zero,
                managed HIPAA-regulated systems, and still stay close enough to
                the code to know what will work.
            </p>
        </OverviewCard>

        <section class="space-y-5">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h2 class="text-3xl font-semibold">Projects</h2>
                <a
                    class="text-sm font-medium text-gray-600 underline underline-offset-4 hover:text-gray-900"
                    href="/projects/"
                >
                    All projects
                </a>
            </div>
            <div class="grid gap-5">
                {
                    projects.map((project) => (
                        <LinkCard
                            href={`/projects/${project.id}/`}
                            title={project.data.title}
                            description={project.data.description}
                            titleElement="h3"
                        />
                    ))
                }
            </div>
        </section>

        <section class="space-y-5">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h2 class="text-3xl font-semibold">Blog</h2>
                <a
                    class="text-sm font-medium text-gray-600 underline underline-offset-4 hover:text-gray-900"
                    href="/blog/"
                >
                    All posts
                </a>
            </div>
            <ol class="space-y-5">
                {
                    posts.map((post) => (
                        <li>
                            <LinkCard
                                href={`/blog/${post.id}/`}
                                title={post.data.title}
                                description={post.data.description}
                                titleElement="h3"
                            />
                        </li>
                    ))
                }
            </ol>
        </section>
    </section>
</BaseLayout>
