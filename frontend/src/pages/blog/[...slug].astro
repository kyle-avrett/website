---
import { getCollection, render } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const posts = await getCollection('blog');

    return posts
        .filter((post) => !post.data.draft)
        .map((post) => ({
            params: { slug: post.id },
            props: { post },
        }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormat = new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
    <article
        class="mx-auto max-w-2xl py-10 [&_a]:font-medium [&_a]:underline [&_blockquote]:border-l-4 [&_blockquote]:border-gray-300 [&_blockquote]:pl-4 [&_code]:rounded [&_code]:bg-gray-100 [&_code]:px-1 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_li]:my-2 [&_ol]:my-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:my-6 [&_p]:leading-8 [&_pre]:my-6 [&_pre]:rounded-2xl [&_pre]:p-4 [&_ul]:my-6 [&_ul]:list-disc [&_ul]:pl-6"
    >
        <header class="mb-10 border-b border-gray-200 pb-8">
            <a class="mb-6 inline-block text-sm text-gray-500" href="/blog/">
                Back to blog
            </a>
            <h1 class="text-4xl font-bold tracking-tight">
                {post.data.title}
            </h1>
            <p class="mt-4 text-lg leading-8 text-gray-600">
                {post.data.description}
            </p>
            <time
                class="mt-4 block text-sm text-gray-500"
                datetime={post.data.pubDate.toISOString()}
            >
                {dateFormat.format(post.data.pubDate)}
            </time>
        </header>

        <Content />
    </article>
</BaseLayout>
