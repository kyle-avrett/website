---
import { getCollection } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';

const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const dateFormat = new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
});
---

<BaseLayout title="Blog" description="Posts by Kyle Avrett.">
    <section>
        <PageHeader
            eyebrow="Blog"
            title="Writing"
            description="Notes, experiments, and work in progress."
        />

        <ol class="space-y-5">
            {
                posts.map((post) => (
                    <li>
                        <a
                            class="block rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md"
                            href={`/blog/${post.id}/`}
                        >
                            <div class="flex flex-wrap items-baseline justify-between gap-3">
                                <h2 class="text-xl font-semibold">
                                    {post.data.title}
                                </h2>
                                <time
                                    class="text-sm text-gray-500"
                                    datetime={post.data.published.toISOString()}
                                >
                                    {dateFormat.format(post.data.published)}
                                </time>
                            </div>
                            <p class="mt-3 leading-7 text-gray-600">
                                {post.data.description}
                            </p>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>
</BaseLayout>
