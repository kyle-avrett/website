---
import { getCollection } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---

<BaseLayout title="Blog" description="Posts by Kyle Avrett.">
    <section>
        <div class="mb-6 space-y-2">
            <h1 class="text-4xl font-bold tracking-tight">Blog</h1>
            <p class="text-gray-600">Interesting things I've written about</p>
        </div>

        <ol class="space-y-5">
            {
                posts.map((post) => (
                    <li>
                        <a
                            class="group relative block rounded-2xl border border-gray-200 bg-white p-5 pr-12 shadow-sm transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md"
                            href={`/blog/${post.id}/`}
                        >
                            <Icon
                                name="tabler:arrow-up-right"
                                aria-hidden="true"
                                class="absolute top-5 right-5 h-5 w-5 text-gray-400 group-hover:text-gray-600"
                            />
                            <h2 class="pr-8 text-xl font-semibold">
                                {post.data.title}
                            </h2>
                            <p class="mt-3 leading-7 text-gray-600">
                                {post.data.description}
                            </p>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>
</BaseLayout>
