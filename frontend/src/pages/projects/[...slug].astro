---
import { getCollection, render } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import Pros from '@components/blog/Pros.astro';
import ProjectsHeader from '@components/projects/ProjectsHeader.astro';

export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects
        .filter((project) => !project.data.draft)
        .map((project) => ({
            params: { slug: project.id },
            props: { project },
        }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
    <article class="space-y-10">
        <ProjectsHeader project={project} />

        <Pros>
            <Content />
        </Pros>
    </article>
</BaseLayout>
