---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
const projects = [
    {
        name: 'Guidebook Studio',
        href: '/projects/guidebook-studio/',
        description:
            'AI field guides for distributed healthcare teams, with source-backed RAG, MCP-backed knowledge access, and healthcare guardrails.',
    },
];
---

<BaseLayout title="Projects" description="Projects by Kyle Avrett.">
    <section>
        <div class="mb-6 space-y-2">
            <h1 class="text-4xl font-bold tracking-tight">Projects</h1>
            <p class="text-gray-600">
                Software Products and Businesses I've shipped
            </p>
        </div>

        <ol class="space-y-5">
            {
                projects.map((project) => (
                    <li>
                        <a
                            class="group relative block rounded-2xl border border-gray-200 bg-white p-5 pr-12 shadow-sm transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md"
                            href={project.href}
                        >
                            <Icon
                                name="tabler:arrow-up-right"
                                aria-hidden="true"
                                class="absolute top-5 right-5 h-5 w-5 text-gray-400 group-hover:text-gray-600"
                            />
                            <h2 class="pr-8 text-xl font-semibold">
                                {project.name}
                            </h2>
                            <p class="mt-3 leading-7 text-gray-600">
                                {project.description}
                            </p>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>
</BaseLayout>
