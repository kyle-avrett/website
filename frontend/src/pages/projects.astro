---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
const projects = [
    {
        name: 'Guidebook Studio',
        href: '/projects/guidebook-studio/',
        description:
            'AI field guides for distributed healthcare teams, with source-backed RAG, MCP-backed knowledge access, and healthcare guardrails.',
    },
];
---

<BaseLayout title="Projects" description="Projects by Kyle Avrett.">
    <section>
        <PageHeader
            eyebrow="Projects"
            title="Projects"
            description="Selected products, experiments, and technical work."
        />

        <ol class="space-y-5">
            {
                projects.map((project) => (
                    <li>
                        <a
                            class="block rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md"
                            href={project.href}
                        >
                            <h2 class="text-xl font-semibold">
                                {project.name}
                            </h2>
                            <p class="mt-3 leading-7 text-gray-600">
                                {project.description}
                            </p>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>
</BaseLayout>
