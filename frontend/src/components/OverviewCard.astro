---
interface Props {
    link: string;
    linkText: string;
    secondLink?: string;
    secondLinkText?: string;
}

const { link, linkText, secondLink, secondLinkText } = Astro.props;
---

<div
    class="not-prose rounded-2xl border border-gray-300 bg-slate-100 p-6 shadow-sm"
>
    <!-- overview -->
    <div class="space-y-4 text-gray-700">
        <slot />
    </div>

    <!-- buttons -->
    <div class="mt-6 flex flex-wrap gap-3">
        <a
            class="rounded-full bg-gray-900 px-4 py-2 text-sm font-medium text-white"
            href={link}
        >
            {linkText}
        </a>
        {
            secondLink !== undefined && secondLinkText !== undefined && (
                <a
                    class="rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700"
                    href={secondLink}
                >
                    {secondLinkText}
                </a>
            )
        }
    </div>
</div>
