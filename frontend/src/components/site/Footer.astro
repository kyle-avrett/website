---
import { Icon } from 'astro-icon/components';

const socials = [
    {
        name: 'LinkedIn',
        url: 'https://linkedin.com/in/kyle-avrett',
        icon: 'tabler:brand-linkedin',
    },
    {
        name: 'GitHub',
        url: 'https://github.com/kyle-avrett',
        icon: 'tabler:brand-github',
    },
    {
        name: 'X',
        url: 'https://x.com/kyleavrett',
        icon: 'tabler:brand-x',
    },
    {
        name: 'Email',
        url: 'mailto:kyle@kyleavrett.com',
        icon: 'tabler:mail',
    },
    {
        name: 'RSS',
        url: '/rss.xml',
        icon: 'tabler:rss',
    },
];
---

<hr class="my-4 border-gray-300" />

<footer class="mb-5">
    <div
        class="flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:text-left"
    >
        <div
            class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-gray-600 sm:justify-start"
        >
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/sitemap-index.xml">Sitemap</a>
        </div>

        <div class="flex items-center justify-center gap-4">
            {
                socials.map(({ url, icon, name }) => (
                    <a href={url}>
                        <Icon name={icon} aria-label={name} class="h-5 w-5" />
                    </a>
                ))
            }
        </div>
    </div>
</footer>
