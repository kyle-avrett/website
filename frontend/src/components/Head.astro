---
import { SEO } from 'astro-seo';

interface Props {
    title?: string;
    description?: string;
}

const { title = 'Kyle Avrett', description = 'Kyle Avrett website.' } =
    Astro.props;
---

<SEO
    charset="utf-8"
    title={title}
    description={description}
    titleTemplate="%s | Kyle Avrett"
    titleDefault="Kyle Avrett"
    twitter={{
        card: 'summary_large_image',
    }}
    extend={{
        meta: [
            {
                name: 'viewport',
                content: 'width=device-width, initial-scale=1.0',
            },
            { name: 'text-scale', content: 'scale' },
            { name: 'fediverse:creator', content: '@username@domain.social' },
        ],
        link: [
            {
                rel: 'alternate',
                type: 'application/rss+xml',
                href: '/rss.xml',
                title: 'RSS Feed',
            },
            { rel: 'sitemap', href: '/sitemap-index.xml' },
            { rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml' },
            { rel: 'icon', href: '/favicon.ico', sizes: '32x32' },
        ],
    }}
/>
