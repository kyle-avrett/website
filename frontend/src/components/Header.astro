---
import { Icon } from 'astro-icon/components';
---

<header class="mt-5">
    <nav class="xs:grid-cols-3 grid grid-cols-[1fr_auto] items-center gap-x-4">
        <!-- logo -->
        <div class="flex justify-start">
            <a href="/" class="text-2xl font-bold">Kyle Avrett</a>
        </div>

        <!-- links -->
        <div
            class="xs:col-span-1 xs:row-start-auto col-span-2 row-start-2 flex gap-4 text-lg font-medium text-gray-600 sm:justify-center"
        >
            <a href="/blog/">Blog</a>
            <a href="/projects/">Projects</a>
            <a href="/work/">Work</a>
        </div>

        <!-- search -->
        <div class="flex justify-end">
            <a href="/search/">
                <Icon
                    name="tabler:search"
                    aria-label="Search"
                    class="h-5 w-5"
                />
            </a>
        </div>
    </nav>
</header>

<hr class="my-4 border-gray-300" />
