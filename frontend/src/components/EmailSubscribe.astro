---
import { API_URL } from 'astro:env/client';

const endpoint = new URL('/api/v1/emails/subscribe', API_URL).toString();
---

<form
    data-email-subscribe
    data-endpoint={endpoint}
    class="space-y-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm"
>
    <div>
        <label class="block text-sm font-medium text-gray-700">
            Name
            <input
                name="name"
                type="text"
                autocomplete="name"
                required
                class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2"
            />
        </label>
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700">
            Email
            <input
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
                title="Use a valid email address."
                required
                class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2"
            />
        </label>
    </div>

    <button
        type="submit"
        class="rounded-full bg-gray-900 px-4 py-2 text-sm font-medium text-white disabled:opacity-60"
    >
        Subscribe
    </button>

    <p
        data-email-status
        class="text-sm text-gray-600"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        hidden
    >
    </p>
</form>

<script>
    document.querySelectorAll('form[data-email-subscribe]').forEach((form) => {
        const status = form.querySelector('[data-email-status]');
        const button = form.querySelector('button[type="submit"]');

        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            if (!(form instanceof HTMLFormElement)) return;
            const endpoint = form.dataset.endpoint;
            if (!endpoint) return;
            const body = new FormData(form);

            if (button instanceof HTMLButtonElement) button.disabled = true;
            if (status instanceof HTMLElement) {
                status.hidden = false;
                status.textContent = 'Subscribing…';
            }

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'content-type': 'application/json' },
                    body: JSON.stringify({
                        name: String(body.get('name') ?? ''),
                        email: String(body.get('email') ?? ''),
                        source: window.location.href,
                    }),
                });

                if (!response.ok) throw new Error('Subscription failed');

                form.reset();
                if (status instanceof HTMLElement) {
                    status.textContent = 'Subscribed. Check your email.';
                }
            } catch {
                if (status instanceof HTMLElement) {
                    status.textContent = 'Subscription failed. Try again.';
                }
            } finally {
                if (button instanceof HTMLButtonElement)
                    button.disabled = false;
            }
        });
    });
</script>
