---
import { Icon } from 'astro-icon/components';

const { post } = Astro.props;

const dateFormat = new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
});
---

<header class="mb-6 space-y-2">
    <h1 class="text-4xl font-bold tracking-tight">{post.data.title}</h1>
    <p class="text-gray-600">{post.data.description}</p>

    <!-- subline -->
    <div
        class="mt-3 flex flex-wrap gap-4 text-sm text-gray-600 dark:text-gray-400"
    >
        <div class="flex items-center">
            <Icon name="tabler:user" class="mr-1 h-5 w-5" />
            <span>Kyle Avrett</span>
        </div>

        <div class="flex items-center">
            <Icon name="tabler:calendar" class="mr-1 h-5 w-5" />
            <span>{dateFormat.format(post.data.published)}</span>
        </div>

        {
            post.data.updated && (
                <div class="flex items-center">
                    <Icon name="tabler:refresh" class="mr-1 h-5 w-5" />
                    <span>Updated: {dateFormat.format(post.data.updated)}</span>
                </div>
            )
        }
    </div>
</header>
