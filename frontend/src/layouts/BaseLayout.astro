---
import '@styles/global.css';

import Head from '@components/site/Head.astro';
import Navbar from '@components/site/Navbar.astro';
import Footer from '@components/site/Footer.astro';

interface Props {
    title: string;
    description: string;
    type?: 'website' | 'article';
    published?: Date;
    updated?: Date;
    noindex?: boolean;
}

const { title, description, type, published, updated, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <Head {title} {description} {type} {published} {updated} {noindex} />
    </head>
    <body>
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:font-medium focus:text-gray-900 focus:ring-2 focus:ring-gray-900"
        >
            Skip to content
        </a>
        <div class="mx-auto flex min-h-screen w-full max-w-4xl flex-col px-6">
            <Navbar />

            <main id="main-content" class="grow py-5" tabindex="-1">
                <slot />
            </main>

            <Footer />
        </div>
    </body>
</html>
